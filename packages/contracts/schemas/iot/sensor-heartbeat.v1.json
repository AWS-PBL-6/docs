{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SensorHeartbeatV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventType", "sentAt", "source"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "eventType": { "const": "sensor.heartbeat" },
    "sentAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "service", "deviceId"],
      "properties": {
        "account": { "const": "iot" },
        "service": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
